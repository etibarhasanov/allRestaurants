# ---------------------------------------------------------------------------
# Google Places API (New)
# ---------------------------------------------------------------------------
# 1. https://console.cloud.google.com/  -> create (or pick) a project
# 2. Enable billing on the project (the Places API has no free-only tier,
#    though it does come with a recurring monthly credit)
# 3. APIs & Services -> Library -> enable "Places API (New)"
# 4. APIs & Services -> Credentials -> Create credentials -> API key
# 5. Restrict the key: API restrictions -> "Places API (New)" only.
#    Leave application restrictions as "None" for a server-side script, or
#    restrict by IP if you run it from a fixed host.
GOOGLE_MAPS_API_KEY=AIza...

# ---------------------------------------------------------------------------
# Salesforce - pick ONE auth block below
# ---------------------------------------------------------------------------

# (A) Username + password + security token (simplest, works on any org)
#     Reset the token at: Settings -> My Personal Information -> Reset My
#     Security Token. Use SF_DOMAIN=test for sandboxes.
SF_USERNAME=you@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token
SF_DOMAIN=login

# (B) Connected App, OAuth 2.0 client credentials flow (recommended for
#     unattended jobs). Setup -> App Manager -> New Connected App -> enable
#     OAuth, scope "api", enable Client Credentials Flow and pick a run-as
#     user. SF_INSTANCE_URL is your My Domain URL.
# SF_CLIENT_ID=3MVG9...
# SF_CLIENT_SECRET=...
# SF_INSTANCE_URL=https://yourdomain.my.salesforce.com

# (C) Already have a session? Paste it here and skip the rest.
# SF_ACCESS_TOKEN=00D...
# SF_INSTANCE_URL=https://yourdomain.my.salesforce.com

# Target object + external id field used for upserts.
SF_OBJECT=Restaurant__c
SF_EXTERNAL_ID_FIELD=Google_Place_Id__c
